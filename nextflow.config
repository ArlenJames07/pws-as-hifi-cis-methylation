manifest {
    name        = 'pws-as-hifi-cis-methylation'
    author      = 'Arlen James Mosquera-Ruiz'
    homePage    = 'https://github.com/ArlenJames07/pws-as-hifi-cis-methylation'
    description = 'PacBio HiFi multi-omics workflow for the PWS/AS 15q11-q13 domain'
    mainScript  = 'main.nf'
    nextflowVersion = '>=24.10.0'
}

params {
    input            = null
    outdir           = 'results'
    reference        = null
    reference_fai    = null
    tandem_repeats   = null
    cnv_exclude      = null
    cpg_model        = null
    gtf              = null
    metadata         = null
    icr_bed          = null
    segdup_bed       = null
    imprintome_bed   = null
    repeats_bed      = null
    figure4_tables   = null
    figure5_tables   = null
    run_figures      = false
    publish_mode     = 'copy'
    deepvariant_bin  = 'run_deepvariant'
    deepvariant_version = '1.8.0'
    pbcpgtools_bin   = 'aligned_bam_to_cpg_scores'
    pbcpgtools_version = '2.3.2'
    min_sv_length    = 50
    help             = false
}

process {
    executor = 'local'
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
    maxRetries = 1
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: process_medium {
        cpus = 4
        memory = 16.GB
        time = 12.h
    }
    withLabel: process_high {
        cpus = 16
        memory = 64.GB
        time = 72.h
    }
    withLabel: process_figure {
        cpus = 4
        memory = 32.GB
        time = 24.h
    }
}

profiles {
    standard {
        process.executor = 'local'
    }
    conda {
        conda.enabled = true
        conda.useMamba = true
    }
    docker {
        docker.enabled = true
        params.deepvariant_bin = '/opt/deepvariant/bin/run_deepvariant'
        process {
            withName: CALL_SMALL_VARIANTS {
                container = 'google/deepvariant:1.8.0'
            }
        }
    }
    slurm {
        process.executor = 'slurm'
        executor.queueSize = 50
    }
    test {
        params.input = "${projectDir}/tests/data/samplesheet.csv"
        params.reference = "${projectDir}/tests/data/reference.fa"
        params.reference_fai = "${projectDir}/tests/data/reference.fa.fai"
        params.tandem_repeats = "${projectDir}/tests/data/tandem_repeats.bed"
        params.cnv_exclude = "${projectDir}/tests/data/cnv.exclude.bed"
        params.cpg_model = "${projectDir}/tests/data/model.tflite"
        params.outdir = "${projectDir}/results-test"
        process.cpus = 1
        process.memory = 1.GB
        process.time = 10.m
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
